{
  "schemaVersion": 1,
  "id": "quests",
  "version": "${version}",
  "name": "Quests",
  "description": "An extensive questing system.",
  "authors": ["PikaMug"],
  "contact": {
    "homepage": "https://github.com/PikaMug/Quests/",
    "sources": "https://github.com/PikaMug/Quests/"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "server",
  "entrypoints": {
    "server": [
      "me.pikamug.quests.FabricQuestsPlugin"
    ]
  },
  "mixins": [
    "quests.mixins.json"
  ],
  "jars": [
    { "file": "META-INF/jars/conversation-fabric.jar" }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "conversation-fabric": "*",
    "minecraft": ">=26.2",
    "java": ">=25"
  },
  "suggests": {
    "placeholder-api": "*",
    "openpartiesandclaims": "*",
    "luckperms": "*",
    "yawp": "*"
  }
}