<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.pikamug.quests</groupId>
        <artifactId>quests-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>quests-fabric</artifactId>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <fabric.loader.version>0.18.4</fabric.loader.version>
        <minecraft.version>26.1</minecraft.version>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>fabricmc</id>
            <url>https://maven.fabricmc.net/</url>
        </repository>
        <repository>
            <id>minecraft-libraries</id>
            <url>https://libraries.minecraft.net/</url>
        </repository>
        <repository>
            <id>modmaven</id>
            <url>https://modmaven.dev/</url>
        </repository>
        <repository>
            <id>cursemaven</id>
            <url>https://cursemaven.com</url>
        </repository>
        <repository>
            <!-- TextPlaceholderAPI (eu.pb4:placeholder-api) -->
            <id>nucleoid</id>
            <url>https://maven.nucleoid.xyz/</url>
        </repository>
        <repository>
            <!-- Open Parties and Claims (xaero.pac:open-parties-and-claims-fabric-*) -->
            <id>chocolateminecraft</id>
            <url>https://chocolateminecraft.com/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Minecraft (Mojang Mappings / official mojmap, provided at runtime by server) -->
        <dependency>
            <groupId>me.pikamug.quests</groupId>
            <artifactId>quests-minecraft-official</artifactId>
            <version>${minecraft.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Maven libraries referenced by the Mojang-mapped server jar (provided at runtime by server) -->
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>9.0.75</version>
            <scope>provided</scope>
        </dependency>

        <!-- Fabric Loader (provided at runtime by server) -->
        <dependency>
            <groupId>net.fabricmc</groupId>
            <artifactId>fabric-loader</artifactId>
            <version>${fabric.loader.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Fabric API sub-modules (aggregate pom is dependency-only, brings nothing in standalone;
             pin the sub-modules the code actually uses, provided at runtime by server) -->
        <dependency>
            <groupId>net.fabricmc.fabric-api</groupId>
            <artifactId>fabric-api-base</artifactId>
            <version>2.0.3+ece06323b3</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.fabricmc.fabric-api</groupId>
            <artifactId>fabric-command-api-v2</artifactId>
            <version>3.0.5+e2bdee78b3</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.fabricmc.fabric-api</groupId>
            <artifactId>fabric-events-interaction-v0</artifactId>
            <version>5.1.10+c82f0461b3</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.fabricmc.fabric-api</groupId>
            <artifactId>fabric-lifecycle-events-v1</artifactId>
            <version>4.0.6+a9b9c176b3</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.fabricmc.fabric-api</groupId>
            <artifactId>fabric-networking-api-v1</artifactId>
            <version>6.3.0+50a808ceb3</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>

        <!-- Minecraft bundled libraries (provided at runtime by server; needed for full classpath) -->
        <dependency>
            <groupId>com.mojang.brigadier</groupId>
            <artifactId>brigadier</artifactId>
            <version>1.3.10</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>datafixerupper</artifactId>
            <version>9.0.19</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>8.5.18</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Gson (on Minecraft's classpath) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Adventure (compile-only: ConversationAPI signatures reference net.kyori.adventure.text.Component) -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.14.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- LuckPerms API (compile-only; provided at runtime by the LuckPerms Fabric mod) -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.5</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J (on Minecraft's classpath) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
            <scope>provided</scope>
        </dependency>

        <!-- ConversationAPI-Fabric (shaded into jar) -->
        <dependency>
            <groupId>com.github.Browsit</groupId>
            <artifactId>ConversationAPI-Fabric</artifactId>
            <version>-SNAPSHOT</version>
            <exclusions>
                <exclusion>
                    <groupId>net.fabricmc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>net.kyori</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- NPC libs: BOs-Easy-NPC and Taterzens are NOT compile dependencies -->
        <!-- They are detected at runtime via FabricLoader.isModLoaded() and reflection -->

        <!-- TextPlaceholderAPI (provided at runtime by the placeholder-api mod; resolves from maven.nucleoid.xyz) -->
        <dependency>
            <groupId>eu.pb4</groupId>
            <artifactId>placeholder-api</artifactId>
            <version>3.0.0+26.1</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Open Parties and Claims (provided at runtime by the openpartiesandclaims mod; Mojang-mapped,
             resolves from chocolateminecraft.com/maven). No artifact exists for 26.1, so 26.1.2 is used;
             its fabric.mod.json declares minecraft ">=26.1 <26.2.0", so the 26.1.2 jar loads on 26.1. -->
        <dependency>
            <groupId>xaero.pac</groupId>
            <artifactId>open-parties-and-claims-fabric-26.1.2</artifactId>
            <version>0.30.3</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- quests-api (shaded into jar) -->
        <dependency>
            <groupId>me.pikamug.quests</groupId>
            <artifactId>quests-api</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <sourceDirectory>${basedir}/src/main/java</sourceDirectory>

        <resources>
            <resource>
                <targetPath>.</targetPath>
                <directory>${basedir}/src/main/resources/</directory>
                <filtering>true</filtering>
                <includes>
                    <include>lang/**/*.*</include>
                    <include>fabric.mod.json</include>
                    <include>config.json</include>
                    <include>quests.json</include>
                    <include>actions.json</include>
                    <include>conditions.json</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <proc>none</proc>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <minimizeJar>false</minimizeJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>

                <configuration>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                    <artifactSet>
                        <includes>
                            <include>com.github.Browsit.ConversationAPI:*</include>
                            <include>me.pikamug.quests:quests-api</include>
                        </includes>
                    </artifactSet>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.MF</exclude>
                                <exclude>LICENSE</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <relocations>
                        <relocation>
                            <pattern>org.browsit.conversation</pattern>
                            <shadedPattern>me.pikamug.quests.libs.conversation</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.browsit.libs.kyori</pattern>
                            <shadedPattern>me.pikamug.quests.libs.kyori</shadedPattern>
                        </relocation>
                    </relocations>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
